# PostgreSQL
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

# Application
JWT_SECRET_KEY=change-me-before-production
SERVER_PORT=3000
ELASTICSEARCH_URL=http://elasticsearch:9200

# Expo web build. Empty values make the browser use the frontend container's
# same-origin reverse proxy (/api and /events).
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SEARCH_URL=
